# Copy this file to .env (same folder as server.js), fill in your values and restart the server. Never commit .env.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword
EMAIL_FROM_NAME=Your Company

# Where the data lives. Leave both out to keep using the JSON file (data/policycenter.json).
# A real PostgreSQL server (production), or memory:// for an in-process demo database:
# DATABASE_URL=postgres://user:password@localhost:5432/policycenter
# DATABASE_URL=memory://
# The write-ahead log that makes a change safe before the database write finishes (default: <DATA_FILE>.wal)
# WAL_FILE=

# The assistant: with a key it answers through Claude; without one it uses the offline rules. A user-scoped key
# (sk-ant-usr-...) also needs the id of its workspace, which the server sends as the anthropic-workspace-id header.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Reaching a person when an agent needs a decision (docs/NOTIFICATIONS.md). Without these, nothing is sent.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_APPROVER=sreenivas
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# APPROVER_PHONE=+919800000000
# PUBLIC_URL=https://your-api-host
# ESCALATE_MINUTES=10

# Copy this file to .env (same folder as server.js), fill in your values and restart the server. Never commit .env.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword
EMAIL_FROM_NAME=Your Company

# Where the data lives. Leave both out to keep using the JSON file (data/policycenter.json).
# A real PostgreSQL server (production), or memory:// for an in-process demo database:
# DATABASE_URL=postgres://user:password@localhost:5432/policycenter
# DATABASE_URL=memory://
# The write-ahead log that makes a change safe before the database write finishes (default: <DATA_FILE>.wal)
# WAL_FILE=

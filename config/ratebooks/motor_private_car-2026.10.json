          "op": "multiply_bps",
          "value": "idv",
          "rate": "base_rate",
          "as": "od_basic"
        },
        {
          "op": "constant",
          "name": "ENGINE_PROTECT_BPS",
          "as": "ep_bps"
        },
        {
          "op": "multiply_bps",
          "value": "od_basic",
          "rate": "ep_bps",
          "as": "ep"

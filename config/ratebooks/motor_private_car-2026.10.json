          "table": "TP_RATE",
          "by": [
            "engine_cc"
          ],
          "as": "tp"
        }
      ],
      "output": "tp"
    },
    "PA_OWNER_DRIVER": {
      "steps": [
        {
          "op": "constant",
          "name": "PA_OWNER_DRIVER_PREMIUM",
          "as": "pa"
        }
      ],
      "output": "pa"
    },
    "MOTOR_OD": {
      "steps": [
        {
          "op": "input",
          "name": "idv",
          "as": "idv"
        },
        {
          "op": "input",
          "name": "engine_cc",
          "as": "engine_cc"
        },
        {
          "op": "input",
          "name": "vehicle_age_years",
          "as": "vehicle_age_years"
        },
        {
          "op": "lookup",
          "table": "OD_BASE_RATE",
          "by": [
            "engine_cc",
            "vehicle_age_years"
          ],
          "as": "base_rate"
        },
        {
          "op": "multiply_bps",
          "value": "idv",
          "rate": "base_rate",
          "as": "od_basic"
        },
        {
          "op": "input",
          "name": "claim_free_years",
          "as": "claim_free_years"
        },
        {
          "op": "input",
          "name": "vol_deductible",
          "as": "vol_deductible"
        },
        {
          "op": "lookup",
          "table": "NCB_SCALE",
          "by": [
            "claim_free_years"
          ],
          "as": "ncb_bps"
        },
        {
          "op": "discount_bps",
          "value": "od_basic",
          "rate": "ncb_bps",
          "as": "od_after_ncb"
        },
        {
          "op": "lookup",
          "table": "VOL_DED_DISC",
          "by": [
            "vol_deductible"
          ],
          "as": "vd_bps"
        },
        {
          "op": "discount_bps",
          "value": "od_after_ncb",
          "rate": "vd_bps",
          "as": "od_net"
        },
        {
          "op": "constant",
          "name": "MIN_OD_PREMIUM",
          "as": "min_od"
        },
        {
          "op": "minimum",
          "value": "od_net",
          "min": "min_od",
          "as": "od_min"
        },
        {
          "op": "round_rupee",
          "value": "od_min",
          "as": "od_final"
        }
      ],
      "output": "od_final"
    },
    "ZERO_DEP": {
      "steps": [
        {
          "op": "input",
          "name": "idv",
          "as": "idv"
        },
        {
          "op": "input",
          "name": "engine_cc",

      "output": "zd"
    },
    "ENGINE_PROTECT": {
      "steps": [
        {
          "op": "input",
          "name": "idv",
          "as": "idv"
        },
        {
          "op": "input",
          "name": "engine_cc",
          "as": "engine_cc"
        },
        {
          "op": "input",
          "name": "vehicle_age_years",

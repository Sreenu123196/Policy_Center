{
  "name": "policycenter-sim",
  "version": "1.0.0",
  "description": "PolicyCenter-style policy administration simulator for Personal Auto and Homeowners",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "gate:policy": "node scripts/policy-gate.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "load-test": "node scripts/load-test.js",
    "generate": "node scripts/generate-test-data.js",
    "reset-manager": "node scripts/reset-manager.js",
    "migrate-to-pg": "node scripts/migrate-to-pg.js",
    "knowledge:eval": "node scripts/knowledge-eval.js",
    "knowledge:quality": "node scripts/knowledge-quality.js",
    "knowledge:gate": "node scripts/knowledge-gate.js",
    "openapi": "node scripts/build-openapi.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google-cloud/speech": "^8.2.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}

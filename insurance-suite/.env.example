# Copy this file to .env and fill in real values. .env is never committed (see .gitignore).
# These values are only examples.

# Used by docker compose: the password of the database user.
POSTGRES_PASSWORD=change-me

# Add the demo users (agent, underwriter, claims handler, cashier, administrator). Only for a demo or a test environment.
SEED_DEMO=false

# To run the API outside Docker against a PostgreSQL server, set DATABASE_URL. Without it, the API keeps a local
# PGlite database in .data/ (fine for trying it out, not for real use).
# DATABASE_URL=postgres://insurance:change-me@localhost:5432/insurance_suite
# PORT=3000
# HOST=127.0.0.1

# Folder where PGlite keeps its files when DATABASE_URL is not set. Leave unset for .data/insurance-suite.
# DATA_DIR=./.data

# How people sign in. With DATABASE_URL the default is oidc; without it, header (X-User, anyone can forge it:
# development only). For oidc, name your identity provider (any OpenID Connect provider that publishes a key set).
# AUTH_MODE=oidc
# OIDC_ISSUER=https://login.example.com/
# OIDC_AUDIENCE=insurance-suite-api
# OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# OIDC_USERNAME_CLAIM=preferred_username

# Dependencies (restore with npm install)
node_modules/

# Local speech service: its Python environment (recreate with the README steps)
.whisper/

# Runtime data: rebuilt from the demo seed on first start, or with npm run generate
data/

# Account-specific assistant settings; copy chat.config.example.json to create it
chat.config.json

# Google service-account keys must never be committed; keep them outside the project
*service-account*.json
*speech-key*.json
*-credentials.json

# Secrets and local environment
.env
.env.*

# Netlify writes this at build time from API_ORIGIN (scripts/netlify-build.js)
public/_redirects

# Editorial and OS files
*.tmp
*.log
*.wal
.DS_Store
Thumbs.db
.vscode/
.idea/
